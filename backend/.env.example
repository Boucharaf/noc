# =====================================================================
# Backend NOC — variables d'environnement
#
# Les trois premières sont PARTAGÉES avec l'ETL : mettre exactement la
# même valeur des deux côtés, sinon le backend lira une autre base ou un
# autre Redis que celui où l'ETL écrit.
# =====================================================================

# --- Entrepôt (identique à etl/.env) ---------------------------------
NOC_WAREHOUSE_DSN=postgresql://noc:noc@postgres:5432/noc_warehouse
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (identique à etl/.env) ------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300

# Préfixe des clés de statut publiées par etl/pipelines/status.py.
# À ne changer que si l'ETL change de préfixe.
ETL_STATUS_KEY_PREFIX=noc:etl:status:

# Intervalle de collecte de l'ETL (etl/config.py). Sert au backend à
# déterminer à partir de quand un statut est considéré comme périmé.
COLLECT_INTERVAL_S=300

# Outils affichés sur la page Interopérabilité
SUPERVISION_TOOLS=zabbix,itop,netxms,centreon,nagios,nsp

# --- Sécurité ---------------------------------------------------------
# OBLIGATOIRE en production : générer avec `openssl rand -hex 32`
SECRET_KEY=changez-moi-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7
# false uniquement en dev local servi en http://
REFRESH_COOKIE_SECURE=true

# Clé présentée par l'ETL sur /api/internal/*. Sans valeur, ces routes
# répondent 503. À reporter dans etl/.env sous le même nom.
INTERNAL_API_KEY=

CORS_ORIGINS=https://noc.anptic.bf,http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=30

# --- Veilleur d'incidents --------------------------------------------
# Remplace l'ancienne ingestion par webhook : détecte les incidents
# écrits par l'ETL et déclenche WebSocket + notifications.
WATCHER_ENABLED=true
WATCHER_INTERVAL_S=30
WATCHER_NOTIFY_SEVERITIES=critical,high

# --- Notifications ----------------------------------------------------
NOTIFICATIONS_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Obligatoire tant que le compte Twilio est en essai : un compte d'essai
# refuse tout corps de message libre et n'accepte que des modèles.
TWILIO_CONTENT_SID=
NOC_SMS_RECIPIENTS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc@anptic.bf
SMTP_USE_TLS=true
NOC_EMAIL_RECIPIENTS=

# Utilisée pour le bouton « Ouvrir l'incident » des e-mails d'alerte
DASHBOARD_URL=https://noc.anptic.bf

# Web Push — générer avec : vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=noc@anptic.bf

# --- Rapports ---------------------------------------------------------
REPORT_OUTPUT_DIR=/var/lib/noc/reports
REPORT_ORGANISATION=ANPTIC — RESINA

# --- Divers -----------------------------------------------------------
LOG_LEVEL=INFO
TZ=Africa/Ouagadougou
NOC_HOUR_START=6
NOC_HOUR_END=21
