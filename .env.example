# =====================================================================
# Configuration de la plateforme NOC RESINA
#
#   cp .env.example .env   puis renseigner AU MINIMUM :
#     SECRET_KEY, INTERNAL_API_KEY, POSTGRES_PASSWORD
#
# Les valeurs par défaut suffisent pour un démarrage local complet
# (`docker compose up -d`). Aucun connecteur de supervision n'est requis :
# sans URL renseignée, l'ETL démarre, ne collecte rien, et le dashboard
# l'affiche explicitement sur l'écran « Collecte ETL » — ce n'est pas une
# panne. Pour une démonstration avec des données, voir
# `backend/scripts/seed_demo.py`.
# =====================================================================

# ---------------------------------------------------------------------
# Entrepôt (PostgreSQL + TimescaleDB) — base UNIQUE de l'ETL et du backend
# ---------------------------------------------------------------------
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Composée automatiquement par docker-compose à partir des trois valeurs
# ci-dessus. À renseigner à la main UNIQUEMENT hors Docker :
#NOC_WAREHOUSE_DSN=postgresql://noc:changez-moi@localhost:5436/noc_warehouse

CACHE_TTL=300
LOG_LEVEL=INFO
TZ=Africa/Ouagadougou

# ---------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------
# Signature des jetons d'accès. À générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=secret_key


# Clé statique présentée par l'ETL sur /api/internal/*. Sans elle, ces
# routes répondent 503 et le rapport mensuel automatique ne part jamais.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

INTERNAL_API_KEY=internal_api_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Cookie du jeton de rafraîchissement. `false` obligatoire tant que l'accès
# se fait en http:// (développement local, port 8888) : à true, le
# navigateur refuse le cookie et la session tombe au bout de 30 minutes.
# Passer à `true` dès que la plateforme est servie en HTTPS.
REFRESH_COOKIE_SECURE=false

# Origines autorisées à appeler l'API. Ajouter l'URL réelle en production.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8888,https://localhost:8443

RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------
# Veilleur d'incidents
# ---------------------------------------------------------------------
# Interroge l'entrepôt toutes les WATCHER_INTERVAL_S secondes et diffuse
# les nouveaux incidents (WebSocket, notifications). Remplace l'ancienne
# ingestion par webhook. ⚠️ Un SEUL conteneur backend doit l'activer.
WATCHER_ENABLED=true
WATCHER_INTERVAL_S=30

# ---------------------------------------------------------------------
# Rapports
# ---------------------------------------------------------------------
REPORT_ORGANISATION=ANPTIC — RESINA
DASHBOARD_URL=https://localhost:8443

# ---------------------------------------------------------------------
# Notifications (toutes facultatives)
# ---------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false

# Notifications navigateur (Web Push). Générer la paire de clés :
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=noc@anptic.bf

# SMS d'astreinte (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONTENT_SID=
TWILIO_FROM_NUMBER=
NOC_SMS_RECIPIENTS=

# Courriel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc@anptic.bf
SMTP_USE_TLS=true
NOC_EMAIL_RECIPIENTS=

# =====================================================================
# Connecteurs de supervision
#
# Un connecteur ne s'active QUE si son <OUTIL>_API_URL est renseignée.
# Laisser vide désactive proprement l'outil : il apparaît « non
# configuré » sur l'écran Collecte ETL, sans erreur.
#
# Les URL ci-dessous pointent vers les instances locales du profil
# « tools » (`docker compose --profile tools up -d`). Pour les vrais
# serveurs de l'agence, remplacer par leurs URL et identifiants.
# =====================================================================
COLLECT_INTERVAL_S=300
SUPERVISION_TOOLS=zabbix,itop,netxms,centreon,nagios,nsp

# --- Zabbix (JSON-RPC) — UI locale http://localhost:8081 ---
ZABBIX_API_ENABLED=true
ZABBIX_API_URL= https://zabbix.anptic.gov.bf/api_jsonrpc.php
ZABBIX_API_USER=ouoba
ZABBIX_API_PASSWORD=Twi^+$$b=p.e}a78
ZABBIX_API_TOKEN=aff083754a184817451edfa13633c5e1
ZABBIX_VERIFY_SSL=true
ZABBIX_DB_RESTORE_ENABLED=false
ZABBIX_DB_DSN=

# --- iTop (REST) — UI locale http://localhost:8082 ---
ITOP_API_ENABLED=true
ITOP_API_URL=https://test.helpdesk-03.mtdpce-test.gov.bf/webservices/rest.php?version=1.0
ITOP_API_USER=xabbis
ITOP_API_PASSWORD=Admin@20260709
ITOP_VERIFY_SSL=true
ITOP_DB_RESTORE_ENABLED=false
ITOP_DB_DSN=

# --- NetXMS (REST v1) — Web API locale http://localhost:8085 ---
NETXMS_API_ENABLED=true
NETXMS_API_URL=http://172.27.11.2:8000
NETXMS_API_USER=admin
NETXMS_API_PASSWORD=netxms
NETXMS_VERIFY_SSL=true
NETXMS_DB_RESTORE_ENABLED=false
NETXMS_DB_DSN=

# --- Centreon (REST v2) — UI locale http://localhost:8084/centreon ---
CENTREON_API_ENABLED=true
CENTREON_API_URL=http://localhost:8084/centreon
CENTREON_API_USER=admin
CENTREON_API_PASSWORD=Centreon!2024
CENTREON_VERIFY_SSL=true
CENTREON_DB_RESTORE_ENABLED=false
CENTREON_DB_DSN=

# --- Nagios — variante à confirmer côté agence ---
# NAGIOS_MODE : livestatus | xi | ndoutils | unknown
NAGIOS_MODE=unknown
NAGIOS_API_ENABLED=false
NAGIOS_API_URL=
NAGIOS_API_USER=nagiosadmin
NAGIOS_API_PASSWORD=nagios
NAGIOS_VERIFY_SSL=true

# --- Nokia NSP — variante à confirmer côté agence ---
# NSP_FM_MODE : classic | yang | unknown
NSP_FM_MODE=unknown
NSP_API_ENABLED=false
NSP_API_URL=
NSP_API_USER=
NSP_API_PASSWORD=
NSP_VERIFY_SSL=true

# =====================================================================
# Bases des outils locaux (profil « tools » uniquement)
# =====================================================================
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=zabbix_db_pass
ZABBIX_DB_NAME=zabbix

NETXMS_DB_USER=netxms
NETXMS_DB_PASSWORD=netxms_db_pass
NETXMS_DB_NAME=netxms

CENTREON_DB_ROOT_PASSWORD=centreon_root_pass
CENTREON_DB_USER=centreon
CENTREON_DB_PASSWORD=centreon_db_pass
CENTREON_PASSWORD=Centreon!2024

ITOP_DB_PASSWORD=itop_db_pass

