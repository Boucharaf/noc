# =====================================================================
#  Plateforme NOC — configuration
# =====================================================================
#
#   cp .env.example .env
#   puis renseigner AU MINIMUM : SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD
#   (docker compose refuse de démarrer tant que l'un d'eux manque)
#
# Générer un secret :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ---------------------------------------------------------------------
#  LIRE CECI AVANT DE TOUCHER AUX VARIABLES <OUTIL>_API_*
# ---------------------------------------------------------------------
# Ces variables désignent les outils que le collecteur interroge. Elles
# pointent SOIT vers les instances locales du laboratoire, SOIT vers les
# instances de production de l'agence — jamais un mélange des deux.
#
# Ce fichier est livré configuré pour le LABORATOIRE LOCAL, parce que c'est
# ce qui doit fonctionner sans rien demander à personne. Le bloc production
# est plus bas, commenté.
#
# Ne dupliquez JAMAIS une variable dans ce fichier : Docker Compose retient
# la DERNIÈRE occurrence, silencieusement. Une seconde définition de
# ZABBIX_DB_PASSWORD après la création du volume rend la base de Zabbix
# inaccessible, et le message affiché est « PostgreSQL server is not
# available » — qui ne parle ni de mot de passe ni de duplication.
# =====================================================================


# =====================================================================
#  1. Base de données du NOC
# =====================================================================
# PostgreSQL simple — PLUS de TimescaleDB. Cette base ne contient ni
# métriques ni historique d'incidents : uniquement les comptes, le travail
# d'exploitation et les agrégats journaliers. Voir backend/sql/schema.sql.
POSTGRES_USER=noc
# Générer avec la commande d'en-tête : le mot de passe est inséré tel quel
# dans une URL de connexion, les caractères @ : / # le casseraient.
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=noc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# À renseigner à la main UNIQUEMENT hors Docker :
#NOC_DATABASE_URL=postgresql://noc:changez-moi@localhost:5436/noc


# =====================================================================
#  2. Redis — instantané et cache
# =====================================================================
# Mot de passe de Redis — OBLIGATOIRE. Redis porte les sessions et le canal
# des alertes : ouvert, n'importe quel conteneur du réseau compose pourrait
# révoquer des sessions ou publier de fausses alertes (qui partiraient en
# SMS). Générer avec la commande d'en-tête.
REDIS_PASSWORD=
# Hors Docker uniquement : docker-compose.yml construit sa propre URL.
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# Cadence de collecte, en secondes. C'EST LA VARIABLE QUI DÉTERMINE LA
# CHARGE IMPOSÉE AUX OUTILS SOURCES : une requête par outil et par
# intervalle, quel que soit le nombre d'opérateurs connectés au tableau de
# bord. C'est le chiffre à présenter à l'équipe sécurité de l'agence.
#
# Le backend DOIT avoir la même valeur que le collecteur : elle fixe la
# durée de vie des clés d'instantané (trois cycles).
COLLECT_INTERVAL_S=300

# Agrégats journaliers (une ligne par jour et par site). Nécessaires aux
# courbes sur plusieurs mois du tableau Direction.
ROLLUP_ENABLED=true
ROLLUP_HOUR=1
# Bilan non écrit (base indisponible) : nouvel essai toutes les … secondes.
ROLLUP_RETRY_S=900

# Journal historique (collector/history.py) : périodes d'état de chaque
# équipement et de chaque lien surveillé, vie de chaque alerte. Donne la
# disponibilité sur la durée, le MTTR technique, et le rattrapage des bilans
# journaliers manquants. Quelques Mo par mois dans la base du NOC.
HISTORY_ENABLED=true
# Jours de conservation de ce qui est clos (0 = indéfiniment, par défaut :
# la disponibilité sur plusieurs années est un besoin).
HISTORY_RETENTION_DAYS=0
# Délai de garde de l'écriture d'un cycle, en secondes.
HISTORY_TIMEOUT_S=60

LOG_LEVEL=INFO
TZ=Africa/Ouagadougou


# =====================================================================
#  3. Sécurité
# =====================================================================
# SECRET_KEY signe les jetons ET sert de clé à l'empreinte des PIN. La changer
# déconnecte tout le monde et oblige à redéfinir les PIN des agents terrain.
# Une valeur par environnement : jamais la même en local et en production.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# `false` OBLIGATOIRE tant que l'accès se fait en http:// (développement
# local, port 8888) : à true, le navigateur refuse le cookie de
# rafraîchissement et la session tombe au bout de trente minutes, sans
# message d'erreur. Passer à `true` dès que la plateforme est en HTTPS.
REFRESH_COOKIE_SECURE=false

# En production : la seule origine HTTPS du NOC (https://noc.exemple.gov.bf).
# `*` est refusé au démarrage.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8888,https://localhost:8443
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=1200
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_USER_READ_PER_MIN=1200
RATE_LIMIT_USER_WRITE_PER_MIN=120

# Verrouillage de la connexion par mot de passe (fenêtre en secondes) :
# échecs tolérés par compte depuis une même adresse (x5 toutes adresses
# confondues), et par adresse tous comptes confondus.
LOGIN_MAX_FAILURES_PER_USER=10
LOGIN_MAX_FAILURES_PER_IP=60
LOGIN_LOCK_WINDOW_SECONDS=900

# Documentation interactive de l'API (/docs). Fermée par défaut ; ne
# l'ouvrir qu'en développement.
API_DOCS_ENABLED=false

# Diffusion temps réel : le backend s'abonne au canal Redis alimenté par le
# collecteur et retransmet aux navigateurs.
REALTIME_ENABLED=true
NOTIFY_SEVERITIES=critical,high


# =====================================================================
#  4. Outils sources — LABORATOIRE LOCAL (actif)
# =====================================================================
# Ces adresses sont des noms de service Docker : elles ne résolvent QUE
# depuis l'intérieur du réseau compose. Un outil s'active par la seule
# présence de son URL ; laisser <OUTIL>_API_URL vide le désactive.
#
# Démarrer les outils :
#   docker compose --profile tools up -d          (les trois)
#   docker compose --profile zabbix up -d         (un seul)
# Puis les peupler avec l'inventaire réel de la pile :
#   docker compose --profile provision run --rm provision
#   docker compose exec centreon /usr/local/bin/provision-lab

# --- Zabbix 7.0.23 --- interface : http://localhost:8081 (Admin / zabbix)
ZABBIX_API_URL=http://zabbix-web:8080
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=zabbix
# Jeton d'API permanent, préférable au couple identifiant/mot de passe : il
# n'expire pas, ne consomme pas de session, et se révoque sans toucher au
# compte. S'il est renseigné, il l'emporte.
ZABBIX_API_TOKEN=
ZABBIX_VERIFY_SSL=false

# --- Centreon 22.10.7 --- interface : http://localhost:8084/centreon
# Deux accès, choisis par la FORME de l'URL :
#   PRODUCTION : API REST v2     CENTREON_API_URL=https://centreon…/centreon
#   LOCAL : export du journal    CENTREON_API_URL=file:///srv/dumps/alertes.sql
# Le second rejoue un export de centreon_storage.logs fourni par l'agence
# (database/alertes.sql), pour le visualiser : il demande le fichier
# docker-compose.dumps.yml (voir son en-tête). USER/PASSWORD y sont ignorés.
CENTREON_API_URL=http://centreon/centreon
CENTREON_API_USER=admin
# Politique de Centreon : 12 caractères minimum, une minuscule, une
# majuscule, un chiffre et l'un de @$!%*?& — et rien en dehors.
CENTREON_API_PASSWORD=Centreon!2024
CENTREON_VERIFY_SSL=false

# --- iTop 3.2.3-2 --- interface : http://localhost:8082
ITOP_API_URL=http://itop
# Compte de SERVICE, créé au premier démarrage avec les seuls profils de
# lecture nécessaires. Ne jamais mettre le compte d'administration ici :
# le collecteur n'a besoin que de lire.
ITOP_API_USER=noc_collector
ITOP_API_PASSWORD=CollecteNOC!2026
ITOP_VERIFY_SSL=false
# Classes de tickets à collecter — à confirmer sur l'instance de l'agence.
ITOP_TICKET_CLASSES=Incident,UserRequest
# Champ personnalisé portant l'identifiant d'événement Zabbix, s'il existe.
# Sans lui, la corrélation ticket <-> alerte se fait sur le nom du CI, ce
# qui est une heuristique et non une certitude.
ITOP_ZBX_EVENT_FIELD=
# Fuseau dans lequel iTop enregistre ses dates : paramètre 'timezone' de
# conf/production/config-itop.php (« Europe/Paris » à l'installation, y
# compris dans le laboratoire). Une valeur fausse décale toutes les dates
# des tickets, donc les délais SLA. À confirmer sur l'instance de l'agence.
ITOP_TIMEZONE=Europe/Paris

# --- NetXMS 5.0 --- deux accès, choisis par la FORME de l'URL :
#
#   PRODUCTION : API Web         NETXMS_API_URL=https://netxms…/api
#   (netxms-websvc)              USER/PASSWORD : un compte NetXMS en lecture
#   LOCAL : base du dump         NETXMS_API_URL=postgresql://netxms-db:5432/netxms
#                                USER/PASSWORD : noc_reader
#
# Avant la mise en service, vérifier ce que l'API renvoie réellement :
#     docker compose run --rm collector python -m collector.probe netxms
#
# En LOCAL, le laboratoire est la base du dump de production (netxms-db,
# section 6) — pour inspecter des données réelles sur VOTRE poste. Ce dump ne
# doit jamais quitter ce poste (préproduction ou tout autre partage compris) :
# voir database/restore_netxms_dump.sh.
#     docker compose --profile netxms up -d netxms-db
#     NETXMS_API_URL=postgresql://netxms-db:5432/netxms
#     NETXMS_API_USER=noc_reader
#     NETXMS_API_PASSWORD=   (= NETXMS_DB_READER_PASSWORD, section 6)
#
# Le code ne change pas d'un accès à l'autre : seule cette variable.
NETXMS_API_URL=
NETXMS_API_USER=
NETXMS_API_PASSWORD=
# Mode API uniquement. En mode base, le chiffrement se règle dans l'URL
# (?sslmode=verify-full).
NETXMS_VERIFY_SSL=true
# Mode API uniquement. L'API ne donne pas le référentiel de sites de l'agence
# (propre à sa base) : sans réglage, le site d'un équipement est la ville de
# son adresse NetXMS. Si l'agence recopie le site administratif dans un
# attribut personnalisé des nœuds, en donner ici le nom (ex. « site »).
# Province et région viennent de la ville ou des coordonnées
# (integrations/data/localities.json).
NETXMS_SITE_ATTRIBUTE=
# Mode API uniquement. État et débit nominal des interfaces (disponibilité
# des liens) : la lecture la plus lourde du cycle, plusieurs dizaines de
# milliers d'objets sur le parc de l'agence. « false » la désactive.
NETXMS_COLLECT_INTERFACES=true

# --- Nagios Core 4.5.12 --- interface : http://localhost:8085/nagios
#   docker compose --profile nagios up -d
# L'URL désigne la RACINE web de Nagios : les CGI JSON sont lus sous
# <URL>/cgi-bin/. Le compte est créé au démarrage du conteneur avec ces
# mêmes valeurs (nagiosadmin : seul compte autorisé à voir tous les hôtes).
NAGIOS_API_URL=http://nagios/nagios
NAGIOS_API_USER=nagiosadmin
NAGIOS_API_PASSWORD=Nagios!Lab2026
NAGIOS_VERIFY_SSL=false
# statusjson (Nagios Core 4.x, CGI livrés en standard) | livestatus | xi.
# Tant que la valeur reste `unknown`, le connecteur se déclare non configuré
# en NOMMANT cette variable, plutôt que de se faire passer pour un outil en
# panne.
NAGIOS_MODE=statusjson
# Mode livestatus uniquement, si l'URL ne porte pas de port.
NAGIOS_LIVESTATUS_PORT=6557

# --- Nokia NSP --- Nokia ne distribue pas NSP. En production : l'URL de la
# passerelle REST, un compte en lecture et le mode. En LOCAL, un simulateur
# (profil « nsp », tools/README.md) :
#     docker compose --profile nsp up -d --build nsp-sim
#     NSP_API_URL=http://nsp-sim:8080  NSP_API_USER=admin
#     NSP_API_PASSWORD=NspLab!2026     NSP_FM_MODE=yang
NSP_API_URL=
NSP_API_USER=
NSP_API_PASSWORD=
NSP_VERIFY_SSL=true
# yang (RESTCONF nsp-fault, recommandé par Nokia) | classic (NBI historique,
# alarmes seules, sans inventaire). Tant qu'il vaut `unknown`, le connecteur
# se déclare non configuré en nommant cette variable.
NSP_FM_MODE=unknown


# =====================================================================
#  5. Outils sources — PRODUCTION DE L'AGENCE (inactif)
# =====================================================================
# Pour basculer : commenter le bloc 4 ci-dessus, décommenter celui-ci.
# Ne jamais avoir les deux actifs — voir l'avertissement en tête de fichier.
#
#ZABBIX_API_URL=https://zabbix.exemple.gov.bf
#ZABBIX_API_TOKEN=
#ZABBIX_VERIFY_SSL=true
#
#CENTREON_API_URL=https://centreon.exemple.gov.bf/centreon
#CENTREON_API_USER=
#CENTREON_API_PASSWORD=
#CENTREON_VERIFY_SSL=true
#
#ITOP_API_URL=https://helpdesk.exemple.gov.bf
#ITOP_API_USER=
#ITOP_API_PASSWORD=
#ITOP_VERIFY_SSL=true
#
# NetXMS par son API Web, avec un compte NetXMS en lecture seule :
#NETXMS_API_URL=https://netxms.exemple.gov.bf/api
#NETXMS_API_USER=
#NETXMS_API_PASSWORD=
#NETXMS_SITE_ATTRIBUTE=


# =====================================================================
#  6. Bases des outils locaux (profil « tools » uniquement)
# =====================================================================
# ⚠️ Ces valeurs sont figées à la CRÉATION du volume de chaque base. Les
# changer ensuite rend la base inaccessible : il faut alors supprimer le
# volume (`docker volume rm noc_zabbix_pgdata`) et laisser l'outil se
# réinstaller.
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=zabbix_db_pass
ZABBIX_DB_NAME=zabbix

CENTREON_DB_ROOT_PASSWORD=centreon_root_pass
CENTREON_DB_USER=centreon
CENTREON_DB_PASSWORD=centreon_db_pass

ITOP_DB_ROOT_PASSWORD=itop_root_pass
ITOP_DB_NAME=itop
ITOP_DB_USER=itop
ITOP_DB_PASSWORD=itop_db_pass
# Compte d'administration de l'interface iTop — distinct du compte de
# service utilisé par le collecteur (ITOP_API_USER plus haut).
ITOP_ADMIN_USER=admin
ITOP_ADMIN_PASSWORD=Admin!2026
ITOP_APP_URL=http://localhost:8082/
ITOP_LANGUAGE=FR FR

# Base NetXMS locale (profil « netxms ») : reçoit le dump de production.
#   docker compose --profile netxms up -d netxms-db
#   bash database/restore_netxms_dump.sh
NETXMS_DB_USER=netxms
NETXMS_DB_PASSWORD=netxms_db_pass
NETXMS_DB_NAME=netxms
# Mot de passe du compte de lecture noc_reader, créé par la restauration.
# À reporter dans NETXMS_API_PASSWORD (section 4).
NETXMS_DB_READER_PASSWORD=



# =====================================================================
#  7. Notifications (toutes facultatives)
# =====================================================================
# Interrupteur général des envois AUTOMATIQUES (SMS et courriel) sur alerte
# grave (NOTIFY_SEVERITIES). Le courriel de test de l'écran Utilisateurs
# fonctionne même à false : il sert à valider la configuration avant
# d'activer.
NOTIFICATIONS_ENABLED=false
# Envoi échoué (serveur SMTP ou passerelle SMS indisponible) : nouvelles
# tentatives à 1, 5, 15, 30 puis 60 minutes, tant que l'alerte est active,
# dans la limite du nombre de tentatives (première comprise) et de l'âge de
# l'alerte. Au-delà, l'envoi est abandonné, journalisé et signalé par
# /api/health. NOTIFY_RETRY_MAX_ATTEMPTS=1 : aucune nouvelle tentative.
NOTIFY_RETRY_MAX_ATTEMPTS=6
NOTIFY_RETRY_MAX_AGE_MIN=360
# Au-delà de ce nombre de nouvelles alertes graves d'un coup (retour après
# une coupure du collecteur), un seul message récapitulatif.
NOTIFY_BURST_MAX=10

# Notifications navigateur (Web Push). Générer la paire de clés :
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=noc@anptic.bf

# SMS d'astreinte (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONTENT_SID=
TWILIO_FROM_NUMBER=
NOC_SMS_RECIPIENTS=

# Courriel. Destinataires = NOC_EMAIL_RECIPIENTS (listes fixes, facultatif)
# + les comptes abonnés depuis l'interface (écran Utilisateurs, ou « Mon
# compte » pour chacun) : ajouter un destinataire ne demande aucun
# redéploiement.
#
# Tester en local sans rien envoyer à personne (lecture sur
# http://localhost:8025) :
#   docker compose --profile mail up -d mailpit
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc@anptic.bf
# 587 : STARTTLS (SMTP_USE_TLS=true). 465 : TLS implicite, déduit du port
# quand SMTP_USE_SSL est vide. Relais interne sans chiffrement : les deux à false.
SMTP_USE_TLS=true
SMTP_USE_SSL=
# false UNIQUEMENT pour un relais interne à certificat auto-signé.
SMTP_VERIFY_SSL=true
NOC_EMAIL_RECIPIENTS=


# =====================================================================
#  8. Rapports
# =====================================================================
REPORT_ORGANISATION=ANPTIC — RESINA
DASHBOARD_URL=https://localhost:8443
