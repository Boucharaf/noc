# Entrepôt (PostgreSQL + TimescaleDB)
NOC_WAREHOUSE_DSN=postgresql://noc:noc@localhost:5432/noc_warehouse

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_URL=redis://localhost:6379/0
COLLECT_INTERVAL_S=300

# --- Zabbix ---
ZABBIX_API_ENABLED=true
ZABBIX_API_URL=https://zabbix.agence.local
ZABBIX_API_USER=
ZABBIX_API_PASSWORD=
ZABBIX_VERIFY_SSL=true
ZABBIX_DB_RESTORE_ENABLED=false
ZABBIX_DB_DSN=

# --- iTop ---
ITOP_API_ENABLED=true
ITOP_API_URL=https://itop.agence.local
ITOP_API_USER=
ITOP_API_PASSWORD=
ITOP_VERIFY_SSL=true
ITOP_DB_RESTORE_ENABLED=false
ITOP_DB_DSN=

# --- NetXMS ---
NETXMS_API_ENABLED=true
